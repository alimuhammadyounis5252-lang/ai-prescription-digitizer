# Copy this file to .env and fill it in. Never commit .env or share it.
#
# The app talks to any OpenAI-compatible vision model server. Pick ONE option.

# --- Option A: Hugging Face Inference Providers (cloud, needs internet) -----
# Token: huggingface.co > Settings > Access Tokens > "Make calls to Inference Providers"
# Model: any vision chat model that currently lists an inference provider on its
#        Hugging Face model page. The line below is an example; check it is still served.
# Privacy: the photo is sent to a third-party server. Use only photos with the
#          patient's name and details cropped out.
VLM_BASE_URL=https://router.huggingface.co/v1
VLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct:ovhcloud
VLM_API_KEY=

# --- Option B: Ollama on this PC (offline, photos never leave the computer) --
# Install Ollama, run:  ollama pull qwen2.5vl:7b   (needs about 8 GB RAM free; slow without a GPU)
# VLM_BASE_URL=http://localhost:11434/v1
# VLM_MODEL=qwen2.5vl:7b
# VLM_API_KEY=

# --- Optional: second reader (recommended) -----------------------------------
# A second, different model reads the same photo. Lines where the two models
# disagree are flagged red for the pharmacist. Doubles the model cost per photo.
# VLM_MODEL_2=
# VLM_BASE_URL_2=      # leave empty to use VLM_BASE_URL
# VLM_API_KEY_2=       # leave empty to use VLM_API_KEY

# --- Optional: access code -----------------------------------------------------
# When set, the app asks for this code before anything can be read or approved.
# Set it whenever other people can reach this computer over the network.
# APP_ACCESS_CODE=

# --- Optional: other ------------------------------------------------------------
# HOST=127.0.0.1        # 0.0.0.0 makes the app reachable from other devices: set APP_ACCESS_CODE first
# PORT=5000
# VLM_TIMEOUT_S=120
# MAX_UPLOAD_MB=15
# KEEP_UPLOADS=0        # 1 = keep a copy of every uploaded photo in uploads/
